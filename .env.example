# Copy to .env and replace every placeholder. Never commit real secrets.
# Read by docker-compose.yml and by Settings.from_env (backend/app/main.py).

# --- Mode -------------------------------------------------------------------
# true: in-memory SMS outbox, demo routes and demo seed, open read APIs.
# false (live): requires every variable marked [live] below, or the app refuses to start.
DRY_RUN=true
# true: in-memory stores and checkpointer, no Postgres or Redis.
USE_IN_MEMORY=false
# stdio (MCP subprocess) or inprocess.
MCP_TRANSPORT=stdio
# Optional directory of the static UI (default: ./frontend).
FRONTEND_DIR=
# Optional public URL of the service. Must not contain a query string.
PUBLIC_BASE_URL=

# --- Database and Redis -------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
MCP_READER_PASSWORD=change-me-mcp-reader
REDIS_PASSWORD=change-me-redis
# Only needed outside docker-compose (compose builds these from the passwords above).
DATABASE_URL=
MCP_READER_DATABASE_URL=
REDIS_URL=

# --- API and webhook secrets ----------------------------------------------------
# [live] Bearer token required on POST /webhooks/alerts.
ALERT_WEBHOOK_SECRET=change-me-alert-secret
# [live] Bearer key for GET /api/incidents and GET /api/incidents/{id}/audit.
API_READ_SECRET=change-me-read-secret
# Legacy opt-in: accept the SMS webhook secret as ?secret= (leaks into access logs).
ALLOW_QUERY_SECRET=false

# --- Africa's Talking SMS -------------------------------------------------------
# [live] Account username ("sandbox" selects the sandbox endpoint).
AFRICASTALKING_USERNAME=your-username
# [live] API key.
AFRICASTALKING_API_KEY=change-me-api-key
# [live] Shared secret for the inbound SMS webhook (header X-Webhook-Secret).
AFRICASTALKING_WEBHOOK_SECRET=change-me-sms-webhook-secret
# Optional sender shortcode. When set, inbound "to" must match.
AFRICASTALKING_SHORTCODE=
# Force the sandbox endpoint.
AFRICASTALKING_SANDBOX=false
# [live] On-call number in E.164 (+254700123456). Local formats such as 0700123456 are rejected.
ONCALL_PHONE_NUMBER=+254700000000

# --- LLM summarizer (optional) ----------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Lifecycle and limits -------------------------------------------------------
APPROVAL_TTL_SECONDS=900
REAPER_INTERVAL_SECONDS=30
INFLIGHT_STALE_SECONDS=60
TRIAGE_TIMEOUT_SECONDS=120
EXECUTING_TIMEOUT_SECONDS=120
PAGE_MAX_ATTEMPTS=3
TOKEN_COOLDOWN_SECONDS=3600
MAX_ALERT_BODY_BYTES=65536
DEDUP_AUDIT_SAMPLE=20
TELEMETRY_MAX_CONCURRENCY=4
PAGE_RATE_PER_MINUTE=6
PAGE_FAILURE_READY_THRESHOLD=3
